---
// Profile line under the home and About hero: who, where, languages, social, save contact, and jump links.
import { SOCIAL, type Lang } from "../lib/site";
interface Props { lang?: Lang; jumps: [string, string][] }
const { lang = "en", jumps } = Astro.props;
const uk = lang === "uk";
const icon = {
  linkedin: "M4 9h4v12H4zM6 3a2 2 0 110 4 2 2 0 010-4zm4 6h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.4 2.6 4.4 6V21h-4v-5.6c0-1.3 0-3-1.9-3s-2.1 1.5-2.1 2.9V21h-4z",
  facebook: "M14 8h3V4h-3c-2.8 0-4 1.7-4 4.3V10H7v4h3v8h4v-8h3l1-4h-4V8.6c0-.4.3-.6.6-.6z",
  instagram: "M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm0 2a3 3 0 00-3 3v10a3 3 0 003 3h10a3 3 0 003-3V7a3 3 0 00-3-3zm5 3.5a4.5 4.5 0 110 9 4.5 4.5 0 010-9zm0 2a2.5 2.5 0 100 5 2.5 2.5 0 000-5zM17.5 6a1 1 0 110 2 1 1 0 010-2z",
};
---
<section class="profile-strip" aria-label={uk ? "Коротко про мене" : "At a glance"}>
  <div class="wrap">
    <div class="ps-row">
      <p class="ps-facts">
        <span><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0114 0C19 14.8 12 21 12 21z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>{uk ? "Офіс в Eden Prairie, працюю по всьому Twin Cities" : "Based in Eden Prairie, serving the Twin Cities"}</span>
        <span><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>{uk ? "Покупці, продавці, інвестори" : "Buyers, sellers and investors"}</span>
        <span class="ps-langs"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg><span lang="en">English</span> · <span lang="uk">Українська</span> · <span lang="ru">Русский</span></span>
      </p>
      <div class="ps-actions">
        <a class="ps-social" href={SOCIAL.linkedin} aria-label="LinkedIn"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={icon.linkedin} fill="currentColor"/></svg></a>
        <a class="ps-social" href={SOCIAL.facebook} aria-label="Facebook"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={icon.facebook} fill="currentColor"/></svg></a>
        <a class="ps-social" href={SOCIAL.instagram} aria-label="Instagram"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={icon.instagram} fill="currentColor" fill-rule="evenodd"/></svg></a>
        <a class="ps-save" href="/nazar-orishchin.vcf" download><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 3v12m0 0l-5-5m5 5l5-5M4 19h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{uk ? "Зберегти контакт" : "Save contact"}</a>
      </div>
    </div>
    <nav class="ps-jumps" aria-label={uk ? "На цій сторінці" : "On this page"}>
      {jumps.map(([href, label]) => <a href={href}>{label}<span aria-hidden="true">↓</span></a>)}
    </nav>
  </div>
</section>
