---
// Count-up stat bar. The real numbers are in the HTML (for search, AI tools and no-JS visitors).
// The script only animates them once when the bar scrolls into view, and skips the animation
// for people who have reduced motion turned on.
import { TEAM, type Lang } from "../lib/site";
import { getGoogleRating } from "../lib/google";
const { lang = "en" } = Astro.props as { lang?: Lang };
const uk = lang === "uk";
const g = await getGoogleRating();
type Stat = { value: number; decimals?: number; suffix?: string; label: string };
const stats: Stat[] = [
  { value: 100, suffix: "+", label: uk ? "Угод закрито з 2022 року" : "Transactions closed since 2022" },
  { value: g.rating, decimals: 1, suffix: "★", label: uk ? `Рейтинг Google, ${g.count} відгуків` : `Google rating from ${g.count} reviews` },
  { value: TEAM.zillow.totalSales, label: uk ? "Продажів Team Steady загалом (Zillow)" : "Team Steady sales, all time (Zillow)" },
  { value: 3, label: uk ? "Мови: українська, англійська, російська" : "Languages: English, Ukrainian, Russian" },
];
const fmt = (s: Stat) => s.value.toLocaleString("en-US", { minimumFractionDigits: s.decimals ?? 0, maximumFractionDigits: s.decimals ?? 0 }) + (s.suffix ?? "");
---
<section class="statbar" aria-label={uk ? "Коротко в цифрах" : "At a glance"}>
  <div class="wrap stats">
    {stats.map((s) => (
      <div class="stat">
        <b><span class="countup" data-to={s.value} data-decimals={s.decimals ?? 0} data-suffix={s.suffix ?? ""} style={`min-width:${fmt(s).length}ch`}>{fmt(s)}</span></b>
        <span>{s.label}</span>
      </div>
    ))}
  </div>
</section>
<script is:inline>
(function () {
  var els = document.querySelectorAll(".countup:not([data-ready])");
  if (!els.length) return;
  var reduce = !("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches;
  els.forEach(function (el) { el.setAttribute("data-ready", ""); });
  if (reduce) return; // final numbers are already in the HTML
  var fmt = function (el, n) {
    var d = +el.dataset.decimals;
    return n.toLocaleString("en-US", { minimumFractionDigits: d, maximumFractionDigits: d }) + el.dataset.suffix;
  };
  var run = function (el) {
    var to = +el.dataset.to, start = null, dur = 1350, done = false;
    var finish = function () { if (!done) { done = true; el.textContent = fmt(el, to); } };
    var step = function (t) {
      if (done) return;
      if (start === null) start = t;
      var p = Math.min(1, (t - start) / dur), e = 1 - Math.pow(1 - p, 3); // ease-out
      if (p >= 1) return finish();
      el.textContent = fmt(el, to * e);
      requestAnimationFrame(step);
    };
    el.textContent = fmt(el, 0); // start from zero only once the animation really begins
    requestAnimationFrame(step);
    setTimeout(finish, dur + 400); // never leave a visitor looking at a zero
  };
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (en) { if (en.isIntersecting) { io.unobserve(en.target); run(en.target); } });
  }, { threshold: 0.4 });
  els.forEach(function (el) { io.observe(el); });
})();
</script>
