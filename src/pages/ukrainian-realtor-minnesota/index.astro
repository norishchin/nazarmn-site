---
import Base from "../../layouts/Base.astro";
import NextStep from "../../components/NextStep.astro";
import PostCard from "../../components/PostCard.astro";
import { Picture } from "astro:assets";
import photo from "../../assets/photos/nazar-laughing.jpg";
import { SITE, agentSchema } from "../../lib/site";
const faqs: [string, string][] = [
  ["Is there a Ukrainian-speaking Realtor in Minnesota?", "Yes. I'm Nazar Orishchin, a licensed Minnesota real estate agent with RE/MAX Results in Eden Prairie. I was born in Ukraine, speak Ukrainian, English and Russian, and help clients buy, sell and invest anywhere in Minnesota, with most of my home sales in the Twin Cities west and south metro."],
  ["Can you explain the purchase agreement and inspection report in Ukrainian?", "Yes. I walk you through the purchase agreement, the inspection report, the appraisal and the closing documents in Ukrainian, so you know what you're signing. The documents themselves are in English, and for legal questions you should also talk to an attorney."],
  ["Can family members who prefer Ukrainian be part of the process?", "Yes. Parents or relatives who are helping with the decision can join calls and showings, and I'll explain each step in whichever language works for them."],
  ["Do you also work in Russian?", "Yes. You can work with me in Ukrainian, Russian or English, or mix them."],
  ["Do you work with investors and commercial property in Ukrainian too?", "Yes. Apartments, mixed use, retail, warehouses, churches and other commercial property, including off-market deals and seller financing, in any of the three languages."],
  ["Чи є в Міннесоті рієлтор, який говорить українською?", "Так. Я Назар Оріщин, ліцензований агент з нерухомості в RE/MAX Results (Eden Prairie). Допомагаю купувати, продавати й інвестувати в нерухомість по всій Міннесоті, українською, англійською або російською."],
  ["Скільки коштує рієлтор для покупця в Міннесоті?", "Комісія не встановлена законом і узгоджується письмово до початку пошуку. На першій розмові я пояснюю, як це працює, і відповідаю на всі запитання українською."],
];
const jsonld = [
  agentSchema({ availableLanguage: ["English", "Ukrainian", "Russian"] }),
  { "@context": "https://schema.org", "@type": "FAQPage",
    mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
];
---
<Base title="Ukrainian-Speaking Realtor in Minnesota | Nazar Orishchin"
  description="Ukrainian-speaking Realtor with RE/MAX Results. Buy, sell or invest in Minnesota in Ukrainian, Russian or English. Рієлтор у Міннесоті українською."
  jsonld={jsonld}>
<div class="wrap page-hero split">
  <div class="stack lg">
    <p class="label">Рієлтор у Міннесоті · Розмовляю українською</p>
    <h1>A Ukrainian-speaking Realtor in Minnesota</h1>
    <p class="lead">I'm Nazar Orishchin. I was born in Ukraine, came to Minnesota at three, and I'm a licensed agent with RE/MAX Results in Eden Prairie. You can buy, sell or invest anywhere in Minnesota with every step explained in Ukrainian. I speak Russian too.</p>
    <div class="answer"><p class="label">Short answer</p><p>Yes, you can work with a licensed Minnesota Realtor entirely in Ukrainian or Russian. I explain the offer, inspection, loan and closing in your language. The paperwork itself is in English.</p></div>
    <div class="cta"><a class="btn primary" href="/book/">Book a 15-min call</a><a class="arrow" href="/uk/">Сайт українською</a></div>
  </div>
  <div class="photo"><Picture src={photo} alt="Nazar Orishchin laughing, seated" widths={[400, 640, 900]} sizes="(max-width: 900px) 92vw, 460px" formats={["avif", "webp"]} fetchpriority="high" loading="eager" /></div>
</div>

<section class="rule"><div class="wrap section split">
  <div class="stack"><h2>Why it helps to hear it in your first language</h2></div>
  <div class="stack">
    <p>A home is the biggest contract most people ever sign, and the hard parts are in the details: contingencies, earnest money, inspection deadlines, what the appraisal means for your loan. Understanding them in the language you think in makes better decisions easier.</p>
    <p>I'm also a former mechanical engineer who grew up working construction jobs with my dad, so the numbers and the house get the same care as the language. I read the inspection line by line and tell you plainly which items matter.</p>
  </div>
</div></section>

<section class="rule"><div class="wrap section stack lg">
  <h2>Buying, selling and investing in Minnesota</h2>
  <div class="grid g3">
    <a class="card" href="/uk/buy/"><p class="label">Купівля · Buying</p><h3>Buy a home in Minnesota</h3><p class="soft grow">From pre-approval to keys in the Twin Cities or anywhere in the state, with each step explained in Ukrainian.</p><span class="arrow">Читати українською</span></a>
    <a class="card" href="/uk/sell/"><p class="label">Продаж · Selling</p><h3>Sell your home</h3><p class="soft grow">A price built on real sales, a short prep list, and a clean launch. You see every offer side by side.</p><span class="arrow">Читати українською</span></a>
    <a class="card" href="/uk/commercial/"><p class="label">Інвестиції · Investing</p><h3>Investment and commercial</h3><p class="soft grow">Apartments, retail, churches and more, on and off the market, including seller financing.</p><span class="arrow">Читати українською</span></a>
  </div>
  <p>Comparing towns? See <a href="/towns/">home prices across 11 west and south metro towns</a>. Learning the words? The <a href="/glossary/">real estate glossary</a> has plain definitions in English and Ukrainian side by side.</p>
</div></section>

<section class="rule" lang="uk"><div class="wrap section split">
  <div class="stack"><p class="chapter">Українською</p><h2>Рієлтор у Міннесоті, який говорить українською</h2></div>
  <div class="stack">
    <p>Я народився в Україні, виріс у Міннесоті і працюю агентом з нерухомості в RE/MAX Results у складі Team Steady. Допомагаю українським родинам купувати і продавати житло та інвестувати в нерухомість у Міннесоті: у Twin Cities, у західних і південних передмістях, і по всьому штату.</p>
    <p><strong>Купівля будинку в Міннесоті.</strong> Пояснюю кожен крок: pre-approval, покази, пропозицію, інспекцію, оцінку і закриття угоди. Документи англійською, але ви знатимете, що підписуєте. <a href="/uk/blog/buying-your-first-home-in-minnesota/">Як виглядає купівля від початку до кінця.</a></p>
    <p><strong>Продаж нерухомості.</strong> Ціна на основі реальних продажів, короткий список підготовки і запуск, розрахований на перший тиждень. <a href="/uk/sell/">Як я продаю будинки.</a></p>
    <p><strong>Інвестиції.</strong> Багатоквартирні будинки, комерційна нерухомість, угоди off-market і фінансування від продавця. Рахую цифри з нуля, перш ніж ви витратите гроші. <a href="/uk/commercial/">Інвестиції та комерційна нерухомість.</a></p>
  </div>
</div></section>

<section class="rule" lang="ru"><div class="wrap section split">
  <div class="stack"><p class="chapter">По-русски</p><h2>Риелтор в Миннесоте, говорящий по-русски</h2></div>
  <div class="stack">
    <p>Я также говорю по-русски. Помогаю покупать, продавать и инвестировать в недвижимость в Миннесоте, объясняю каждый шаг сделки: предложение, инспекцию, кредит и закрытие. Документы на английском, но вы будете понимать, что подписываете.</p>
    <p>Запишитесь на 15-минутный звонок, и мы обсудим ваши планы на удобном вам языке.</p>
  </div>
</div></section>

<section class="rule"><div class="wrap section stack lg">
  <h2>Guides in Ukrainian</h2>
  <div class="grid g2"><PostCard slug="buying-your-first-home-in-minnesota" lang="uk" /><PostCard slug="your-first-step-before-buying-a-home" lang="uk" /></div>
</div></section>

<section class="rule"><div class="wrap section split faq">
  <h2>Common questions</h2>
  <div>{faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
</div></section>
<NextStep head="Поговоримо українською?" text="A short call in Ukrainian, Russian or English about what you're planning. No pressure and no paperwork." />
</Base>
