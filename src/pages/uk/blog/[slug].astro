---
import PostPage from "../../../components/PostPage.astro";
import { getPosts } from "../../../lib/posts";
export async function getStaticPaths() {
  return (await getPosts()).filter((p) => p.uk).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
---
<PostPage post={Astro.props.post} lang="uk" />
