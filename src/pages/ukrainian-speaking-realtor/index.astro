---
import Base from "../../layouts/Base.astro";
import NextStep from "../../components/NextStep.astro";
import PostCard from "../../components/PostCard.astro";
import { Picture } from "astro:assets";
import photo from "../../assets/photos/nazar-laughing.jpg";
import { SITE, agentSchema } from "../../lib/site";
const faqs: [string, string][] = [
  ["Is there a Ukrainian-speaking real estate agent in Minnesota?", "Yes. I'm Nazar Orishchin, a licensed Minnesota real estate agent with RE/MAX Results in Eden Prairie. I was born in Ukraine, speak Ukrainian, English and Russian, and help clients buy, sell and invest anywhere in Minnesota."],
  ["Can you explain the purchase agreement and inspection report in Ukrainian?", "Yes. I walk you through the purchase agreement, the inspection report, the appraisal and the closing documents in Ukrainian, so you know what you're signing. The documents themselves are in English, and for legal questions you should also talk to an attorney."],
  ["Can family members who prefer Ukrainian be part of the process?", "Yes. Parents or relatives who are helping with the decision can join calls and showings, and I'll explain each step in whichever language works for them."],
  ["Do you also work in Russian?", "Yes. I speak Russian as well, so you can work with me in Ukrainian, Russian or English, or mix them."],
  ["Do you work with investors and commercial property in Ukrainian too?", "Yes. Apartments, mixed use, retail, warehouses, churches and other commercial property, including off-market deals and seller financing, in either language."],
];
const jsonld = [agentSchema(), { "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) }];
---
<Base title="Ukrainian-Speaking Real Estate Agent in Minnesota | Nazar Orishchin"
  description="Nazar Orishchin is a Ukrainian-speaking real estate agent with RE/MAX Results in Minnesota. Buy, sell or invest with every step explained in Ukrainian."
  jsonld={jsonld}>
<div class="wrap page-hero split">
  <div class="stack lg">
    <p class="label">Розмовляю українською</p>
    <h1>A Ukrainian-speaking real estate agent in Minnesota</h1>
    <p class="lead">I'm Nazar Orishchin. I was born in Ukraine, came to Minnesota at three, and I'm a licensed agent with RE/MAX Results. You can buy, sell or invest with every step explained in Ukrainian. I speak Russian too.</p>
    <div class="answer"><p class="label">Short answer</p><p>Yes, you can work with a licensed Minnesota agent entirely in Ukrainian. I explain the offer, inspection, loan and closing in Ukrainian, and the paperwork itself is in English.</p></div>
    <div class="cta"><a class="btn primary" href="/book/">Book a 15-min call</a><a class="arrow" href="/uk/">Сайт українською</a></div>
  </div>
  <div class="photo"><Picture src={photo} alt="Nazar Orishchin laughing, seated" widths={[400, 640, 900]} sizes="(max-width: 900px) 92vw, 460px" formats={["avif", "webp"]} fetchpriority="high" loading="eager" /></div>
</div>
<section class="rule"><div class="wrap section split">
  <div class="stack"><h2>Why it helps to hear it in your first language</h2></div>
  <div class="stack">
    <p>Buying or selling a home is the biggest contract most people ever sign, and the hard parts are in the details: contingencies, earnest money, inspection deadlines, what the appraisal means for your loan. Understanding them in the language you think in makes better decisions easier.</p>
    <p>I'm also a former engineer, so the numbers get the same care as the language. I read the inspection line by line and tell you plainly which items matter.</p>
  </div>
</div></section>
<section class="rule"><div class="wrap section stack lg">
  <h2>What I help with</h2>
  <div class="grid g3">
    <a class="card" href="/uk/buy/"><p class="label">Купівля</p><h3>Buying a home</h3><p class="soft grow">From pre-approval to keys, with each step explained in Ukrainian.</p><span class="arrow">Читати українською</span></a>
    <a class="card" href="/uk/sell/"><p class="label">Продаж</p><h3>Selling a home</h3><p class="soft grow">Pricing on real sales, a short prep list, and a clean launch.</p><span class="arrow">Читати українською</span></a>
    <a class="card" href="/uk/commercial/"><p class="label">Інвестиції</p><h3>Investment and commercial</h3><p class="soft grow">Apartments, retail, churches and more, on and off the market.</p><span class="arrow">Читати українською</span></a>
  </div>
  <p>Learning the words? The <a href="/glossary/">real estate glossary</a> has plain definitions in English and Ukrainian side by side.</p>
  <div class="grid g2"><PostCard slug="buying-your-first-home-in-minnesota" lang="uk" /><PostCard slug="your-first-step-before-buying-a-home" lang="uk" /></div>
</div></section>
<section class="rule"><div class="wrap section split faq">
  <h2>Common questions</h2>
  <div>{faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
</div></section>
<NextStep head="Поговоримо українською?" text="A short call in Ukrainian or English about what you're planning. No pressure and no paperwork." />
</Base>
