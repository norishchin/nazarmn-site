---
import Base from "../../layouts/Base.astro";
import NextStep from "../../components/NextStep.astro";
import { TERMS } from "../../data/glossary";
import { SITE } from "../../lib/site";
const GUIDE_NAMES: Record<string, string> = {
  "/blog/your-first-step-before-buying-a-home/": "your first step before buying a home",
  "/blog/what-i-look-for-in-an-inspection-report/": "what I look for in an inspection report",
  "/blog/buying-your-first-home-in-minnesota/": "buying a home in Minnesota, start to finish",
  "/blog/contract-for-deed-minnesota/": "contract for deed in Minnesota",
  "/blog/how-off-market-commercial-deals-happen/": "how off-market deals happen",
};
const id = (s: string) => s.toLowerCase().replace(/\(.*?\)/g, "").trim().replace(/[^a-z0-9]+/g, "-").replace(/-$/, "");
const jsonld = [{
  "@context": "https://schema.org", "@type": "DefinedTermSet", name: "Real estate glossary, English and Ukrainian",
  url: SITE + "/glossary/", inLanguage: ["en", "uk"],
  hasDefinedTerm: TERMS.map((t) => ({ "@type": "DefinedTerm", name: t.en, alternateName: t.uk, description: t.def, url: `${SITE}/glossary/#${id(t.en)}` })),
}];
---
<Base title="Real Estate Glossary in English and Ukrainian | Nazar Orishchin"
  description="Plain definitions of real estate terms in English and Ukrainian: earnest money, contingency, homestead, contract for deed, cap rate and more."
  jsonld={jsonld}>
<div class="wrap page-hero stack lg">
  <p class="label">Glossary · Словник</p>
  <h1>Real estate terms in plain English and Ukrainian</h1>
  <p class="lead">The words you'll hear when buying, selling or investing in Minnesota, explained in both languages. <span lang="uk">Терміни, які ви почуєте під час купівлі, продажу чи інвестування, пояснені двома мовами.</span></p>
  <p class="soft">General information, not legal or tax advice.</p>
</div>
<section class="rule"><div class="wrap section">
  <nav class="jump" aria-label="Terms">{TERMS.map((t) => <a href={`#${id(t.en)}`}>{t.en.replace(/ \(.*\)/, "")}</a>)}</nav>
  <dl class="glossary">
    {TERMS.map((t) => (
      <div class="term" id={id(t.en)}>
        <dt><span>{t.en}</span><span class="uk" lang="uk">{t.uk}</span></dt>
        <dd><p>{t.def}</p><p lang="uk" class="soft">{t.defUk}</p>{t.link && <p><a class="arrow" href={t.link}>{t.link === "/calculator/" ? "Try the investment calculator" : `Read: ${GUIDE_NAMES[t.link] ?? "the guide"}`}</a></p>}</dd>
      </div>
    ))}
  </dl>
</div></section>
<NextStep head="Have a term that isn't here?" text="Ask me on a short call, in English or Ukrainian. If it comes up a lot, I'll add it." />
</Base>
