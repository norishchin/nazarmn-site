---
import Base from "../../layouts/Base.astro";
import NextStep from "../../components/NextStep.astro";
import { TOWNS, SOURCE, METRO, money } from "../../data/towns";
import { SITE } from "../../lib/site";
const rows = [...TOWNS].sort((a, b) => b.medians[4] - a.medians[4]);
const pct = (a: number, b: number) => Math.round(((a - b) / b) * 100);
const top = rows[0], low = rows[rows.length - 1];
const fastest = [...TOWNS].sort((a, b) => a.days - b.days)[0];
const busiest = [...TOWNS].sort((a, b) => b.sales - a.sales)[0];
const answer = `In 2024, median sale prices across these 11 west and south metro towns ranged from ${money(low.medians[4])} in ${low.name} to ${money(top.medians[4])} in ${top.name}. ${busiest.name} had the most sales (${busiest.sales.toLocaleString("en-US")}) and ${fastest.name} sold fastest (${fastest.days} days on average). The Twin Cities region median was ${money(METRO.median)}.`;
const jsonld = [
  { "@context": "https://schema.org", "@type": "Dataset", name: "2024 home sales by town, west and south Twin Cities metro",
    description: answer, url: SITE + "/towns/", creator: { "@id": SITE + "/#agent" },
    isBasedOn: SOURCE.url, temporalCoverage: "2020/2024", spatialCoverage: "Minnesota, USA",
    variableMeasured: ["Median sale price", "Closed sales", "Cumulative days on market", "Percent of original list price received"] },
  { "@context": "https://schema.org", "@type": "ItemList", itemListElement: rows.map((t, i) => ({ "@type": "ListItem", position: i + 1, url: `${SITE}/${t.slug}/`, name: `${t.name}, MN` })) },
];
---
<Base title="West Metro Home Prices by Town, 2024 | Nazar Orishchin"
  description="2024 median home prices, sales and days on market for Chaska, Chanhassen, Eden Prairie, Plymouth, Maple Grove and six more Minnesota towns."
  jsonld={jsonld}>
<div class="wrap page-hero stack lg">
  <p class="label">Town guides</p>
  <h1>Home prices by town in the west and south metro</h1>
  <p class="lead">The 11 towns where I do the most work, side by side. Click a town for its five-year price trend and what the numbers mean for buyers and sellers.</p>
  <div class="answer"><p class="label">Short answer</p><p>{answer}</p></div>
</div>
<section class="rule"><div class="wrap section">
  <div class="table-wrap">
  <table class="data">
    <caption>2024 full-year numbers, sorted by median sale price</caption>
    <thead><tr><th scope="col">Town</th><th scope="col">Median price</th><th scope="col">Since 2020</th><th scope="col">Sales</th><th scope="col">Days on market</th><th scope="col">% of list price</th><th scope="col">New construction</th></tr></thead>
    <tbody>
      {rows.map((t) => (
        <tr>
          <th scope="row"><a href={`/${t.slug}/`}>{t.name}</a></th>
          <td>{money(t.medians[4])}</td>
          <td>+{pct(t.medians[4], t.medians[0])}%</td>
          <td>{t.sales.toLocaleString("en-US")}</td>
          <td>{t.days}</td>
          <td>{t.pctOrig}%</td>
          <td>{t.newConstruction}%</td>
        </tr>
      ))}
      <tr class="metro"><th scope="row">Twin Cities region</th><td>{money(METRO.median)}</td><td></td><td>{METRO.sales.toLocaleString("en-US")}</td><td>{METRO.days}</td><td>{METRO.pctOrig}%</td><td></td></tr>
    </tbody>
  </table>
  </div>
  <p class="source">Source: <a href={SOURCE.url}>{SOURCE.name}</a>, {SOURCE.period}, published {SOURCE.published}. "Days on market" is cumulative days on market. Twin Cities region is the 16-county region.</p>
</div></section>
<section class="rule"><div class="wrap section split">
  <div class="stack"><h2>How to read this</h2></div>
  <div class="stack">
    <p><strong>Median price</strong> is the middle sale: half sold for more, half for less. It moves with the mix of homes sold, so a year heavy on new construction or townhouses can shift it.</p>
    <p><strong>Days on market</strong> and <strong>% of list price</strong> tell you how much leverage buyers have. Fewer days and a number near 100% means sellers are in a stronger spot.</p>
    <p><strong>New construction</strong> matters if you're selling a resale home: in towns with a lot of it, you're competing with builders.</p>
    <p>Town-wide numbers hide a lot. Two homes a mile apart can sell very differently. For your house or your price range, I'll pull the recent sales that actually compare.</p>
  </div>
</div></section>
<NextStep head="Want the numbers for your street?" text="Tell me the town and price range. I'll pull recent sales that actually compare and walk you through them." />
</Base>
